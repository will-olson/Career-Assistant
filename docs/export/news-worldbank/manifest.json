{
  "package": "news-worldbank-export",
  "description": "Seam index for NewsAPI and World Bank paths from Flask through React. Line numbers match the audited source.",
  "secrets": "Names only. NEWS_API_KEY and OPENAI_API_KEY are read in server/app.py via dotenv. Values are not in this package.",
  "hosts": {
    "flask": ["http://127.0.0.1:5555", "http://localhost:5555"],
    "craProxy": "http://localhost:5555",
    "craProxyConfig": "client/package.json#proxy",
    "newsapi": "https://newsapi.org/v2/everything",
    "worldBankV2": "https://api.worldbank.org/v2",
    "worldBankIndicator": "http://api.worldbank.org/v2/country/all/indicator/{indicator}",
    "dataCatalog": "https://datacatalogapi.worldbank.org/ddhxext/Search",
    "openai": "https://api.openai.com/v1/chat/completions"
  },
  "auth": {
    "clientKey": "localStorage.user_id",
    "login": "POST /login returns user_id; client stores it. Flask session is not set on login.",
    "logout": "POST /logout pops session user_id; client removes localStorage user_id"
  },
  "boundary": {
    "id": "alphavantage.on-data-page",
    "note": "Data page also calls GET /api/top-stocks, GET /symbol-search, and GET /financial-metrics/:symbol. Those are Alpha Vantage, not World Bank. Do not migrate them as part of the World Bank surfaces."
  },
  "seams": [
    {
      "id": "newsapi.fetch",
      "userRoute": null,
      "purpose": "Single NewsAPI choke point. All news headlines pass through this function.",
      "client": null,
      "server": {
        "file": "server/app.py",
        "symbol": "fetch_news_for_company",
        "lines": "36-57",
        "cache": {
          "store": "news_cache",
          "key": "company_name string",
          "ttlSeconds": 86400,
          "constant": "CACHE_TTL",
          "constantLines": "22-23"
        }
      },
      "upstream": {
        "method": "GET",
        "url": "https://newsapi.org/v2/everything",
        "authEnv": "NEWS_API_KEY",
        "query": {
          "q": "company name, not ticker or domain",
          "language": "en",
          "sortBy": "relevancy",
          "pageSize": 10
        },
        "notSent": ["from", "to", "sources", "domains", "excludeDomains"]
      },
      "renderedFields": [],
      "contract": "contracts/newsapi.request.json",
      "trace": "traces/01-newsapi-choke-point.md"
    },
    {
      "id": "news.industry.categories",
      "userRoute": "/industry-news",
      "purpose": "Sidebar of industry names. No news yet.",
      "client": {
        "file": "client/src/components/IndustryNews.js",
        "symbol": "fetchCategories",
        "lines": "10-20",
        "call": "GET http://127.0.0.1:5555/categories"
      },
      "server": {
        "file": "server/app.py",
        "symbol": "get_categories",
        "lines": "495-498",
        "route": "GET /categories"
      },
      "upstream": null,
      "renderedFields": ["name"],
      "contract": null,
      "trace": "traces/02-industry-news.md"
    },
    {
      "id": "news.industry.category",
      "userRoute": "/industry-news",
      "purpose": "Companies in one category, each with up to 5 title/url headlines.",
      "client": {
        "file": "client/src/components/IndustryNews.js",
        "symbol": "handleCategoryClick",
        "lines": "37-48",
        "call": "GET http://127.0.0.1:5555/categories/{categoryName}",
        "renderLines": "76-110"
      },
      "server": {
        "file": "server/app.py",
        "symbol": "view_companies_in_category_and_news",
        "lines": "500-516",
        "route": "GET /categories/<category_name>",
        "articleCount": 5,
        "articleShape": "stripped to title and url"
      },
      "upstream": {
        "via": "newsapi.fetch",
        "desiredArticleCount": 5
      },
      "renderedFields": ["company_name", "news_articles[].title", "news_articles[].url"],
      "emptyCopy": "No news articles available.",
      "contract": "contracts/category-news.response.json",
      "trace": "traces/02-industry-news.md"
    },
    {
      "id": "news.profile.favorites",
      "userRoute": "/profile",
      "purpose": "Load favorites, remap company_id to id, then fan out news.",
      "client": {
        "file": "client/src/components/ProfilePage.js",
        "symbol": "fetchFavorites",
        "lines": "33-61",
        "call": "GET /favorites?user_id={id}",
        "transport": "CRA proxy to http://localhost:5555",
        "remap": "company_id -> id, company_name -> name"
      },
      "server": {
        "file": "server/app.py",
        "symbol": "manage_favorites GET",
        "lines": "454-468",
        "route": "GET /favorites",
        "bodyShape": "JSON array, not { favorites: [...] }"
      },
      "upstream": null,
      "renderedFields": ["name", "link", "category", "indeed"],
      "contract": "contracts/favorites.get.response.json",
      "trace": "traces/03-profile-related-news.md",
      "contrast": {
        "unusedRoute": "GET /profile",
        "unusedLines": "534-556",
        "unusedShape": "{ name, favorites: [{ id, company_name, link, indeed, category }] }",
        "unusedContract": "contracts/profile.get.response.json"
      }
    },
    {
      "id": "news.profile.articles",
      "userRoute": "/profile",
      "purpose": "N+1 news fetch. UI reads title and url only.",
      "client": {
        "file": "client/src/components/ProfilePage.js",
        "symbol": "fetchNewsForFavorites",
        "lines": "64-84",
        "call": "GET /news/{favorite.id}",
        "transport": "CRA proxy",
        "renderFile": "client/src/components/News.js",
        "renderLines": "3-22"
      },
      "server": {
        "file": "server/app.py",
        "symbol": "get_news_for_company",
        "lines": "518-532",
        "route": "GET /news/<int:company_id>",
        "articleCount": 5,
        "articleShape": "full NewsAPI article objects"
      },
      "upstream": {
        "via": "newsapi.fetch",
        "desiredArticleCount": 5
      },
      "renderedFields": ["company_name", "articles[].title", "articles[].url"],
      "emptyCopy": "No news available.",
      "contract": "contracts/company-news.response.json",
      "trace": "traces/03-profile-related-news.md"
    },
    {
      "id": "news.career.client-prefetch",
      "userRoute": "/career-assistant",
      "purpose": "Client tries to prefetch favorites and news. The favorites check never matches the API, so news state stays empty.",
      "client": {
        "file": "client/src/components/CareerAssistant.js",
        "symbols": ["fetchUserFavorites", "fetchNewsArticles"],
        "lines": "38-101",
        "calls": [
          "GET http://localhost:5555/favorites?user_id={userId}",
          "GET http://localhost:5555/news/{favorite.id}"
        ],
        "expects": "response.data.favorites and favorite.id / favorite.name"
      },
      "server": {
        "file": "server/app.py",
        "symbol": "manage_favorites GET",
        "lines": "460-468",
        "actualBody": "array of { company_id, company_name, link, indeed, category }"
      },
      "upstream": {
        "via": "newsapi.fetch",
        "reached": false,
        "reason": "userFavorites stays [] because response.data.favorites is undefined"
      },
      "renderedFields": [],
      "contract": "contracts/favorites.get.response.json",
      "trace": "traces/04-career-assistant.md"
    },
    {
      "id": "news.career.server-prompt",
      "userRoute": "/career-assistant",
      "purpose": "Logged-in POST. Server ignores client news_articles and rebuilds 3 headlines per favorite into the GPT prompt.",
      "client": {
        "file": "client/src/components/CareerAssistant.js",
        "symbol": "handleSubmit",
        "lines": "177-203",
        "call": "POST http://localhost:5555/career-assistant",
        "renderLines": "226-241, 287-300",
        "ignoredByServer": ["user_favorites", "news_articles"]
      },
      "server": {
        "file": "server/app.py",
        "symbol": "career_assistant",
        "lines": "63-204",
        "newsLines": "84-100",
        "promptInstructionLines": "145-146",
        "openaiLines": "183-201",
        "route": "POST /career-assistant",
        "requires": "JSON user_id",
        "articleCount": 3
      },
      "upstream": [
        {
          "via": "newsapi.fetch",
          "desiredArticleCount": 3,
          "fieldsUsed": ["title", "url"]
        },
        {
          "method": "POST",
          "url": "https://api.openai.com/v1/chat/completions",
          "model": "gpt-4o-mini",
          "temperature": 0.7
        }
      ],
      "renderedFields": ["response"],
      "render": "formatResponse turns bare URLs into anchors; GPT is also given prebuilt <a> tags",
      "contract": "contracts/career-assistant.request.json",
      "trace": "traces/04-career-assistant.md"
    },
    {
      "id": "wb.country.browser",
      "userRoute": "/data",
      "purpose": "Country metadata from the browser. Search filters country name. First paint is 4 shuffled countries.",
      "client": {
        "file": "client/src/components/DataPage.js",
        "symbols": ["fetchTopCountries", "fetchCountries", "handleCountrySearchChange"],
        "lines": "38-92",
        "renderLines": "318-327",
        "call": "GET https://api.worldbank.org/v2/country?format=json"
      },
      "server": null,
      "upstream": {
        "method": "GET",
        "url": "https://api.worldbank.org/v2/country",
        "query": { "format": "json" },
        "envelope": "[metadata, rows]",
        "rowIndexUsed": 1
      },
      "renderedFields": ["name", "region", "incomeLevel", "capitalCity"],
      "mappedButNotRendered": ["id", "longitude", "latitude"],
      "contract": "contracts/worldbank.country.mapped.json",
      "trace": "traces/05-data-page-regions-topics.md"
    },
    {
