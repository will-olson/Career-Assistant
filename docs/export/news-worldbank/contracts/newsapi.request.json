{
  "id": "newsapi.request",
  "caller": "server/app.py fetch_news_for_company lines 44-50",
  "method": "GET",
  "url": "https://newsapi.org/v2/everything",
  "auth": {
    "location": "query",
    "name": "apiKey",
    "env": "NEWS_API_KEY"
  },
  "query": {
    "q": "<company name string, free text>",
    "apiKey": "<NEWS_API_KEY>",
    "language": "en",
    "sortBy": "relevancy",
    "pageSize": 10
  },
  "notSent": ["from", "to", "sources", "domains", "excludeDomains", "searchIn"],
  "cache": {
    "key": "company_name",
    "ttlSeconds": 86400,
    "store": "process-local dict news_cache",
    "cachedPayload": "raw articles array before the [Removed] filter and slice",
    "onHit": "filter title != '[Removed]', then slice to desired_article_count"
  },
  "slice": {
    "fetchPageSize": 10,
    "defaultDesiredCount": 5,
    "callers": {
      "GET /categories/<category_name>": 5,
      "GET /news/<company_id>": 5,
      "POST /career-assistant": 3
    }
  },
  "onNon200": []
}
